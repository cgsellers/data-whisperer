# Auth
JWT_SECRET=dev-secret-change-in-prod-min-32-chars
JWT_ALGORITHM=HS256

# Database (local para testing sin Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/platform

# Redis (local para testing sin Docker)
REDIS_URL=redis://localhost:6379/0

# Observabilidad
LOG_LEVEL=INFO
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Agents
AGENT_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# External APIs (opcional - para conectores reales)
STRIPE_API_KEY=sk_test_your_key
GITHUB_TOKEN=ghp_your_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
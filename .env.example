# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-prod-min-32-chars
JWT_ALGORITHM=HS256

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/platform

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# ─────────────────────────────────────────────
# LLM Configuration (para agentes)
# ─────────────────────────────────────────────
LLM_PROVIDER=mock                 # mock | openai | anthropic
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=                   # Tu API key de OpenAI
ANTHROPIC_API_KEY=                # Tu API key de Anthropic
LLM_DAILY_BUDGET_USD=10.0         # Presupuesto diario en USD
LLM_CACHE_ENABLED=true            # Cache semántico en Redis
LLM_CACHE_TTL_SECONDS=86400       # 24 horas

# ─────────────────────────────────────────────
# Sandbox (Python Agent)
# ─────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_SECONDS=10

# ─────────────────────────────────────────────
# LangGraph
# ─────────────────────────────────────────────
LANGGRAPH_CHECKPOINT_POOL_SIZE=5

# ─────────────────────────────────────────────
# Agents
# ─────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# ─────────────────────────────────────────────
# External APIs (opcional - para conectores reales)
# ─────────────────────────────────────────────
STRIPE_API_KEY=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=